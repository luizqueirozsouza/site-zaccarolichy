---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text' | 'light' | 'outlineLight';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;
const base = 'inline-flex items-center justify-center gap-2 text-sm font-semibold transition-colors duration-150 px-6 py-3.5';
const styles = {
  primary: 'bg-navy text-white hover:bg-navy-soft',
  secondary: 'border border-navy/25 text-navy hover:border-gold hover:text-gold-dark',
  text: 'px-0 py-0 text-gold-dark hover:text-navy underline underline-offset-4 decoration-gold/50',
  light: 'bg-white text-navy hover:bg-sand',
  outlineLight: 'border border-white/35 text-white hover:border-gold hover:text-gold',
};
---
<a href={href} class={`${base} ${styles[variant]} ${className}`}>
  <slot />
</a>
