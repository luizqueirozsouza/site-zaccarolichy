---
interface Props { eyebrow?: string; title: string; intro?: string; align?: 'left' | 'center' }
const { eyebrow, title, intro, align = 'left' } = Astro.props;
---
<div class={align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl'}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="text-[clamp(2rem,1.4rem+2.4vw,3rem)] leading-[1.15] text-navy">{title}</h2>
  {intro && <p class="mt-5 text-muted">{intro}</p>}
</div>
