---
interface Props { titulo: string; area: string; data: string; resumo: string; href: string }
const { titulo, area, data, resumo, href } = Astro.props;
---
<article class="border-t border-line pt-6">
  <p class="text-xs uppercase tracking-widest text-gold">{area} · <time>{data}</time></p>
  <h3 class="mt-3 font-display text-2xl leading-snug text-navy"><a href={href} class="hover:text-gold-dark">{titulo}</a></h3>
  <p class="mt-3 text-sm text-muted">{resumo}</p>
  <a href={href} class="mt-4 inline-block text-sm text-gold-dark underline underline-offset-4">Ler artigo</a>
</article>
