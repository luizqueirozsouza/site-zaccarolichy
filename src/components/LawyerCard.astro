---
import { Image } from 'astro:assets';
interface Props { nome: string; cargo: string; oab: string; bio: string; foto?: ImageMetadata }
const { nome, cargo, oab, bio, foto } = Astro.props;
---
<div class="grid gap-8 md:grid-cols-[220px_1fr] md:items-start">
  <div class="aspect-[4/5] bg-sand">
    {foto ? <Image src={foto} alt={`Retrato de ${nome}`} widths={[220, 440]} sizes="220px" class="h-full w-full object-cover" /> : <div class="flex h-full items-center justify-center font-display text-3xl text-gold">DZL</div>}
  </div>
  <div>
    <h3 class="font-display text-2xl text-navy">{nome}</h3>
    <p class="mt-1 text-xs uppercase tracking-widest text-gold">{cargo}</p>
    <p class="mt-1 text-sm text-muted">{oab}</p>
    <p class="mt-4 text-sm text-muted">{bio}</p>
  </div>
</div>
