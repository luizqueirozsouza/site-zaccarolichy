---
import { AREAS } from '../lib/site';
interface Props { turnstileKey: string }
const { turnstileKey } = Astro.props;
const areas = AREAS.map((a) => a.titulo);
---
<form id="contact-form" class="grid gap-5" novalidate>
  <div class="hidden"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  <div><label for="nome" class="text-sm font-medium text-navy">Nome completo *</label><input id="nome" name="nome" required autocomplete="name" class="mt-2 w-full border border-line bg-paper px-4 py-3" /></div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div><label for="email" class="text-sm font-medium text-navy">E-mail *</label><input id="email" name="email" type="email" required autocomplete="email" class="mt-2 w-full border border-line bg-paper px-4 py-3" /></div>
    <div><label for="telefone" class="text-sm font-medium text-navy">Telefone / WhatsApp *</label><input id="telefone" name="telefone" type="tel" required autocomplete="tel" class="mt-2 w-full border border-line bg-paper px-4 py-3" /></div>
  </div>
  <div><label for="area" class="text-sm font-medium text-navy">Área de interesse *</label><select id="area" name="area" required class="mt-2 w-full border border-line bg-paper px-4 py-3">{areas.map((a) => <option value={a}>{a}</option>)}</select></div>
  <div><label for="urgencia" class="text-sm font-medium text-navy">Urgência</label><select id="urgencia" name="urgencia" class="mt-2 w-full border border-line bg-paper px-4 py-3"><option value="normal">Sem urgência</option><option value="media">Nos próximos dias</option><option value="alta">Urgente</option></select></div>
  <div><label for="resumo" class="text-sm font-medium text-navy">Resumo do caso *</label><textarea id="resumo" name="resumo" rows="5" required minlength="20" class="mt-2 w-full border border-line bg-paper px-4 py-3"></textarea></div>
  <label class="flex items-start gap-3 text-xs text-muted"><input type="checkbox" name="consentimento" required class="mt-1" /><span>Autorizo o contato e o tratamento dos meus dados para esta finalidade, conforme a <a href="/politica-de-privacidade/" class="underline">Política de Privacidade</a>. *</span></label>
  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-language="pt-BR"></div>}
  <div id="form-feedback" role="status" aria-live="polite" class="hidden text-sm"></div>
  <button type="submit" class="inline-flex items-center justify-center bg-navy px-6 py-3.5 text-sm font-semibold text-white hover:bg-navy-soft">Enviar mensagem</button>
</form>
{turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import { validarContato } from '../lib/contato';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const fd = new FormData(form);
    const dados = Object.fromEntries(fd.entries());
    const feedback = document.getElementById('form-feedback')!;
    const erros = validarContato(dados as never);
    if (Object.keys(erros).length > 0) {
      feedback.className = 'text-sm text-red-700';
      feedback.textContent = Object.values(erros)[0];
      return;
    }
    feedback.className = 'text-sm text-muted';
    feedback.textContent = 'Enviando...';
    const response = await fetch('/api/contato', { method: 'POST', body: fd });
    const json = (await response.json()) as { ok: boolean; message: string };
    feedback.className = json.ok ? 'text-sm text-green-800' : 'text-sm text-red-700';
    feedback.textContent = json.message;
    if (json.ok) form.reset();
  });
</script>
