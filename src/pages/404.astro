---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Zaccaro Lichy Advocacia" description="A página que você procura não existe ou foi movida." path="/404">
  <section class="section container-page text-center">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-4 text-5xl text-navy">Página não encontrada</h1>
    <p class="mt-4 text-muted">O endereço pode ter mudado ou não existe.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="bg-navy px-6 py-3 text-sm font-semibold text-white">Voltar à home</a>
      <a href="/areas-de-atuacao/" class="border border-navy/25 px-6 py-3 text-sm font-semibold text-navy">Áreas de atuação</a>
    </div>
  </section>
</Base>
