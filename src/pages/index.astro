---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AreaRow from '../components/AreaRow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StatBand from '../components/StatBand.astro';
import LawyerCard from '../components/LawyerCard.astro';
import { SITE, WHATSAPP_URL } from '../lib/site';
import hero from '../assets/images/hero.jpg';
import logo from '../assets/images/logo.jpg';

const areas = (await getCollection('areas')).sort((a, b) => a.data.ordem - b.data.ordem);
const artigos = (await getCollection('publicacoes')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base title={SITE.titulo} description={SITE.descricao} path="/">
  <section class="relative isolate flex min-h-[78vh] items-center overflow-hidden bg-navy text-white">
    <Image src={hero} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45" />
    <div class="container-page py-24">
      <p class="eyebrow">Advocacia preventiva e contenciosa</p>
      <h1 class="mt-5 max-w-4xl text-[clamp(2.75rem,1.6rem+5vw,4.5rem)] leading-[1.05] tracking-[-0.02em]">
        Excelência técnica e dedicação exclusiva à defesa dos seus direitos.
      </h1>
      <p class="mt-6 max-w-2xl text-lg font-light text-white/80">
        Atuação jurídica moderna, pautada pela ética profissional, rigor analítico e busca pelas soluções legais mais seguras para pessoas físicas e empresas.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="/contato/" variant="light">Fale conosco</Button>
        <Button href="/areas-de-atuacao/" variant="outlineLight">Áreas de atuação</Button>
      </div>
    </div>
  </section>

  <section class="container-page"><StatBand /></section>

  <section class="section container-page grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow="O escritório" title="Tradição, transparência e segurança jurídica para suas decisões" />
      <p class="mt-6 text-muted">Fundado com o compromisso de prestar serviços jurídicos de alta precisão técnica, o escritório alia sólida formação acadêmica à agilidade das demandas contemporâneas. A advocacia preventiva é tratada como a forma mais eficaz de mitigar riscos e preservar patrimônio.</p>
      <p class="mt-4 text-muted">Cada causa é conduzida de forma individualizada, com clareza sobre riscos, etapas processuais e alternativas de resolução.</p>
      <Button href="/o-escritorio/" variant="text" class="mt-6">Conhecer o escritório</Button>
    </div>
    <div class="border border-line bg-sand p-8">
      <img src={logo.src} alt="Logo Zaccaro Lichy Advocacia" width="280" height="120" class="h-24 w-auto" />
      <p class="mt-6 font-display text-2xl leading-snug text-navy">Advocacia preventiva e contenciosa para decisões de alto impacto.</p>
      <p class="mt-4 text-sm text-muted">{SITE.oab} · CNPJ {SITE.cnpj}</p>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container-page">
      <SectionHeading eyebrow="Áreas de atuação" title="Atuação jurídica organizada por especialidade" intro="Sete frentes de trabalho, com atendimento consultivo e contencioso." />
      <div class="mt-10">{areas.map((a, i) => <AreaRow numero={i + 1} titulo={a.data.title} resumo={a.data.resumo} href={`/areas-de-atuacao/${a.id}/`} />)}</div>
    </div>
  </section>

  <section class="section container-page">
    <SectionHeading eyebrow="Corpo jurídico" title="Advogado responsável" />
    <div class="mt-10 max-w-3xl">
      <LawyerCard nome="Dr. Davi Zaccaro Lichy" cargo="Sócio fundador" oab={SITE.oab} bio="Pós-graduado em Direito Penal, Processo Penal e Direito Imobiliário, e pós-graduando em Direito Empresarial. Atuação estratégica consultiva e contenciosa perante tribunais estaduais e superiores." />
      <Button href="/equipe/davi-zaccaro-lichy/" variant="text" class="mt-6">Ver perfil completo</Button>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container-page">
      <SectionHeading eyebrow="Publicações" title="Conteúdo jurídico" intro="Artigos informativos sobre temas recorrentes." />
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {artigos.map((a) => <ArticleCard titulo={a.data.title} area={a.data.area} data={a.data.date.toLocaleDateString('pt-BR')} resumo={a.data.resumo} href={`/publicacoes/${a.id}/`} />)}
      </div>
    </div>
  </section>

  <section class="bg-navy py-20 text-white">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="eyebrow">Contato</p>
        <h2 class="mt-3 text-[clamp(2rem,1.4rem+2.4vw,3rem)]">Converse com o escritório</h2>
        <p class="mt-4 max-w-2xl text-white/70">Atendimento presencial em São Paulo e online em todo o território nacional.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/contato/" variant="light">Enviar mensagem</Button>
        <Button href={WHATSAPP_URL} variant="outlineLight">WhatsApp {SITE.whatsapp}</Button>
      </div>
    </div>
  </section>
</Base>
