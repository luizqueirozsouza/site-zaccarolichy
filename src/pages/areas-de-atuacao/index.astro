---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AreaRow from '../../components/AreaRow.astro';
const areas = (await getCollection('areas')).sort((a, b) => a.data.ordem - b.data.ordem);
---
<Base title="Áreas de Atuação | Zaccaro Lichy Advocacia" description="Conheça as sete áreas de atuação do escritório Zaccaro Lichy Advocacia." path="/areas-de-atuacao/">
  <section class="section container-page">
    <SectionHeading eyebrow="Atuação" title="Áreas de atuação" intro="Assessoria consultiva e contenciosa para pessoas físicas e empresas." />
    <div class="mt-12">{areas.map((a, i) => <AreaRow numero={i + 1} titulo={a.data.title} resumo={a.data.resumo} href={`/areas-de-atuacao/${a.id}/`} />)}</div>
  </section>
</Base>
